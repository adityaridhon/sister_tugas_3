# Konfigurasi Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Per-instance ports (gunakan oleh docker-compose)
CACHE1_PORT=8001
CACHE2_PORT=8002
CACHE3_PORT=8003

QUEUE1_PORT=8004
QUEUE2_PORT=8005
QUEUE3_PORT=8006

LOCK1_PORT=8007
LOCK2_PORT=8008
LOCK3_PORT=8009

# Konfigurasi Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Peer lists (format: host:port, terpisah koma)
# Untuk cache nodes: peer adalah semua cache instances
PEERS_CACHE=cache1:8001,cache2:8002,cache3:8003
# Untuk queue nodes: peer adalah semua queue instances
PEERS_QUEUE=queue1:8004,queue2:8005,queue3:8006
# Untuk lock nodes (Raft cluster): semua lock instances
PEERS_LOCK=lock1:8007,lock2:8008,lock3:8009

# NOTE: untuk testing lokal tanpa Docker, Anda bisa set PEERS_* ke localhost:port atau sesuaikan .env